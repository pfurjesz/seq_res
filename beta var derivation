$$
E[\hat{\beta} \mid X]=\beta,
$$


$$
\begin{aligned}
\operatorname{Var}(\hat{\beta} \mid X) & =\operatorname{Var}\left(\left.\frac{\sum_i x_i \varepsilon_i}{\sum_i x_i^2} \right\rvert\, X\right) \\
& =\frac{\sum_i x_i^2 \sigma_{\varepsilon}^2}{\left(\sum_i x_i^2\right)^2} \\
& =\frac{\sigma_{\varepsilon}^2}{\sum_i x_i^2} .
\end{aligned}
$$

--------------------

\begin{frame}{Rolling-window movement and coefficient sensitivity}

\scriptsize

Consider the centered regression
\[
y_i=\beta x_i+\varepsilon_i,
\qquad
\hat\beta_t=
\frac{\sum_{i\in W_t}x_i y_i}
     {\sum_{i\in W_t}x_i^2}.
\]

Define
\[
S_t:=\sum_{i\in W_t}x_i^2.
\]

From the usual OLS result,
\[
\operatorname{Var}(\hat\beta_t\mid X_t)
=
\frac{\sigma_\varepsilon^2}{S_t},
\qquad
SE_t(\hat\beta)
=
\frac{\hat\sigma_{\varepsilon,t}}{\sqrt{S_t}}.
\]

Moving the window by $k$ observations means
\[
W_{t+k}
=
\left(W_t\setminus\mathcal D_t\right)\cup\mathcal A_t,
\]
where $\mathcal D_t$ contains the dropped observations and
$\mathcal A_t$ the added observations.

The new coefficient is
\[
\hat\beta_{t+k}
=
\frac{
\hat\beta_t S_t
-\sum_{i\in\mathcal D_t}x_i y_i
+\sum_{i\in\mathcal A_t}x_i y_i
}{
S_t
-\sum_{i\in\mathcal D_t}x_i^2
+\sum_{i\in\mathcal A_t}x_i^2
}.
\]

Hence
\[
\boxed{
\hat\beta_{t+k}-\hat\beta_t
=
\frac{
\sum_{i\in\mathcal A_t}
x_i(y_i-x_i\hat\beta_t)
-
\sum_{i\in\mathcal D_t}
x_i(y_i-x_i\hat\beta_t)
}{
S_t
+\sum_{i\in\mathcal A_t}x_i^2
-\sum_{i\in\mathcal D_t}x_i^2
}.
}
\]

\begin{block}{Interpretation}
The coefficient changes because observations are added and removed.
Large prediction errors and low information in the current design
can generate large coefficient movements.
\end{block}

\end{frame}


----------


\begin{frame}{Why is the current SE informative about future movement?}

\scriptsize

From the exact rolling-window formula,
\[
\hat\beta_{t+k}-\hat\beta_t
=
\frac{
\sum_{i\in\mathcal A_t}
x_i(y_i-x_i\hat\beta_t)
-
\sum_{i\in\mathcal D_t}
x_i(y_i-x_i\hat\beta_t)
}{
S_t+\Delta S_t
},
\]
where
\[
\Delta S_t
=
\sum_{i\in\mathcal A_t}x_i^2
-
\sum_{i\in\mathcal D_t}x_i^2.
\]

If only a small fraction of the window is replaced,
\[
|\Delta S_t|\ll S_t,
\]
then
\[
\frac{1}{S_t+\Delta S_t}
=
\frac{1}{S_t}
\frac{1}{1+\Delta S_t/S_t}
\approx
\frac{1}{S_t}.
\]

Therefore,
\[
\boxed{
\hat\beta_{t+k}-\hat\beta_t
\approx
\frac{
\sum_{i\in\mathcal A_t}
x_i(y_i-x_i\hat\beta_t)
-
\sum_{i\in\mathcal D_t}
x_i(y_i-x_i\hat\beta_t)
}{
S_t
}.
}
\]

Recall
\[
\boxed{
SE_t(\hat\beta)
=
\frac{\hat\sigma_{\varepsilon,t}}{\sqrt{S_t}}.
}
\]

Thus a high current SE contains two relevant signals:
\[
\boxed{
\hat\sigma_{\varepsilon,t}\ \text{large}
\quad\Rightarrow\quad
\text{large absolute future prediction errors are more plausible}
}
\]

and
\[
\boxed{
S_t\ \text{small}
\quad\Rightarrow\quad
\text{the regression is more sensitive to entering/leaving observations}.
}
\]

\begin{block}{Main idea}
A large $SE_t(\hat\beta)$ does not determine the next movement,
but identifies conditions under which large
$|\hat\beta_{t+k}-\hat\beta_t|$ are more plausible.
\end{block}

\end{frame}
